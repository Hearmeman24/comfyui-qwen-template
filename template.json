{
  "template_repo": "https://github.com/Hearmeman24/comfyui-qwen-template.git",
  "branch": "master",
  "provisioning_mode": "walk",
  "flags": {
    "DOWNLOAD_QWEN_IMAGE": {
      "default": false,
      "extra_models": [
        "Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors"
      ],
      "folders": [
        "Qwen Image"
      ]
    },
    "DOWNLOAD_QWEN_IMAGE_EDIT": {
      "default": false,
      "extra_models": [
        "Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors"
      ],
      "folders": [
        "Qwen Image Edit"
      ]
    },
    "download_qwen_21": {
      "default": false,
      "extra_models": [
        "Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors"
      ],
      "folders": [
        "Qwen Image 2.1"
      ]
    },
    "DOWNLOAD_Z_IMAGE": {
      "default": false,
      "extra_models": [
        "Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors"
      ],
      "folders": [
        "Z-Image"
      ]
    },
    "download_boogu": {
      "default": false,
      "extra_models": [
        "Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors"
      ],
      "folders": [
        "Boogu"
      ]
    },
    "download_krea2": {
      "default": false,
      "extra_models": [
        "krea2_raw_bf16.safetensors",
        "krea2_turbo_lora_rank_64_bf16.safetensors",
        "krea2_identity_edit_v1_2_r128.safetensors",
        "Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors"
      ],
      "folders": [
        "Krea 2"
      ]
    },
    "influencer_maxxing": {
      "default": false,
      "folders": [],
      "extra_models": [
        "krea2_turbo_bf16.safetensors",
        "qwen3vl_4b_bf16.safetensors",
        "qwen3.5_9b_qwen_image_2.1_pe_t2i.int8_convrot.safetensors",
        "Wan2_1_VAE_fp32.safetensors",
        "Krea2_TextFusion_Refusal_Reduction.safetensors",
        "seedvr2_ema_7b_fp16.safetensors",
        "ema_vae_fp16.safetensors",
        "qwen3vl_4b_fp8_scaled.safetensors"
      ]
    }
  },
  "swap_groups": [
    {
      "env": "QWEN_IMAGE_PRECISION",
      "default": "bf16",
      "flags": [
        "DOWNLOAD_QWEN_IMAGE"
      ],
      "profiles": {
        "bf16": {
          "qwen_image_2512": "qwen_image_2512_bf16.safetensors"
        },
        "fp8": {
          "qwen_image_2512": "qwen_image_2512_fp8_e4m3fn.safetensors"
        }
      }
    },
    {
      "env": "BOOGU_PRECISION",
      "default": "bf16",
      "flags": [
        "download_boogu"
      ],
      "profiles": {
        "bf16": {
          "base": "boogu_image_base_bf16.safetensors",
          "edit": "boogu_image_edit_bf16.safetensors",
          "turbo": "boogu_image_turbo_bf16.safetensors"
        },
        "fp8": {
          "base": "boogu_image_base_fp8_scaled.safetensors",
          "edit": "boogu_image_edit_fp8_scaled.safetensors",
          "turbo": "boogu_image_turbo_fp8_scaled.safetensors"
        }
      }
    }
  ],
  "deprecated_flags": {
    "DOWNLOAD_HMFEMME": "HMFemme is retired: it shipped no models of its own, only four personal LoRA slots layered on the standard Qwen Image pipeline. Use DOWNLOAD_QWEN_IMAGE instead. Models already on your network volume are untouched; the flag now enables nothing and queues nothing."
  },
  "models_symlink": true,
  "custom_nodes": {
    "target": "image",
    "repos": [
      "https://github.com/spacepxl/ComfyUI-VAE-Utils.git",
      "https://github.com/Hearmeman24/ComfyUI-QwenImageRefPack.git"
    ],
    "flag_repos": {
      "influencer_maxxing": [
        "https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler.git|4490bd1f482e026674543386bb2a4d176da245b9",
        "https://github.com/Jonseed/ComfyUI-Detail-Daemon.git|3394e44afea04ed0188fb37b21f0d9952469766b"
      ]
    }
  },
  "sage": true,
  "extra_model_paths": [
    "SEEDVR2"
  ]
}
